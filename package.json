{
    "name": "vscode-to-aibp",
    "displayName": "VSCode send message to AIBP",
    "version": "1.0.2",
    "description": "在 VSCode 中选中代码/文本，附上指令，一键发送到终端中正在运行 AIBP 的 agent，例如 opencode、pi 等，采用 AIBP 协议",
    "publisher": "someok",
    "license": "MIT",
    "icon": "images/icon.png",
    "scripts": {
        "compile": "tsc -p ./",
        "watch": "tsc -watch -p ./",
        "package": "vsce package"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/someok/vscode-to-aibp"
    },
    "homepage": "https://github.com/someok/vscode-to-aibp",
    "bugs": {
        "url": "https://github.com/someok/vscode-to-aibp/issues"
    },
    "engines": {
        "vscode": "^1.80.0"
    },
    "categories": [
        "Other"
    ],
    "activationEvents": [
        "onStartupFinished"
    ],
    "main": "./out/extension.js",
    "contributes": {
        "commands": [
            {
                "command": "vscode-to-aibp.send",
                "title": "💬 发送给 AIBP"
            },
            {
                "command": "vscode-to-aibp.sendInput",
                "title": "AIBP: 发送输入文档"
            }
        ],
        "keybindings": []
    },
    "devDependencies": {
        "@types/node": "^20.0.0",
        "@types/vscode": "^1.80.0",
        "typescript": "^5.3.0",
        "vsce": "2.15.0"
    }
}
